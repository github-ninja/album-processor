# Telegram bot token from @BotFather
BOT_TOKEN=123456789:replace-me
# Your Telegram user ID (e.g. from @userinfobot): the only user the bot obeys
ALLOWED_ID=123456789

# Host folders mounted into the container
DOWNLOADS_DIR=/path/to/downloads
MUSIC_DIR=/path/to/music

# Optional: Discogs personal access token (discogs.com/settings/developers),
# raises the rate limit from 25 to 60 requests per minute
DISCOGS_TOKEN=

# Optional: what to do with a suspected lossy→lossless upconvert — ask | warn | skip
UPCONVERT_ACTION=ask
# Optional: an album already in the library — ask (compare mastering passports) | replace
REPLACE_ACTION=ask

# Optional: Anton's opinions on albums (/opinion) — a free Gemini API key from aistudio.google.com
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Only for these requests, if the Gemini API is not available in your server's country:
# GEMINI_PROXY=socks5h://host:1080

# Optional: deezer-downloader (/deezer), as Anton's container sees it
# DEEZER_DOWNLOADER_URL=http://deezer-downloader:5000
# DEEZER_DOWNLOADER_DIR=/downloads/deezer

TZ=Europe/Moscow
